//-----------------------------------------------------------------------------
// filaments.rc - resources for the Filaments screen saver.
// Original work for this repository.
//-----------------------------------------------------------------------------
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_DESCRIPTION     "Filaments"
END

IDD_CONFIG DIALOGEX 0, 0, 240, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Filaments Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Number of filaments", IDC_COUNT_LABEL, 12, 10, 120, 8
    CONTROL         "", IDC_COUNT, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 20, 216, 20
    LTEXT           "Filament width", IDC_WIDTH_LABEL, 12, 46, 120, 8
    CONTROL         "", IDC_WIDTH, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 56, 216, 20
    LTEXT           "Flow speed", IDC_SPEED_LABEL, 12, 82, 120, 8
    CONTROL         "", IDC_SPEED, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 92, 216, 20
    AUTOCHECKBOX    "Cycle colours across the filaments", IDC_RAINBOW, 12, 118, 180, 10
    DEFPUSHBUTTON   "OK", IDOK, 128, 130, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 130, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Filaments Screen Saver"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Filaments"
            VALUE "OriginalFilename", "Filaments.scr"
            VALUE "ProductName",      "D3DX-Engine original screen savers"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END
