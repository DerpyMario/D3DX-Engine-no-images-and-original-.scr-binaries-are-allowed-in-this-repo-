    IDS_SAVERNAME                   "Screen Saver.3DText"
    IDS_OPTIONS                     "Options"
    IDS_TYPE                        "Type"
    IDS_TEXTURE                     "Texture"
    IDS_TEXTURE_FILE_OFFSET         "TextureFileOffset"
    IDS_SIZE                        "Size"
    IDS_TESSELATION                 "Tesselation"
    IDS_SCREENSAVERTITLE            "ScreenSaver"
    IDS_DEFFONT                     "Segoe"
