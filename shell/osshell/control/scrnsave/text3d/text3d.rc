    IDS_CHARSET                     "CharSet"
    IDS_TEXT                        "Text"
    IDS_SPEED                       "Speed"
    IDS_ROTSTYLE                    "RotStyle"
END

//-----------------------------------------------------------------------------
// Display settings dialogs and error strings of the D3DSaver9 framework
// (Windows Vista SP1 revision)
//-----------------------------------------------------------------------------
#define D3DSAVER9_SP1
#include "../d3dsaver9/d3dsaver9.rc"

//-----------------------------------------------------------------------------
// Version
//-----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
FILEVERSION     6,0,6001,18000
PRODUCTVERSION  6,0,6001,18000
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "3D Text Screen Saver"
            VALUE "FileVersion",      "6.0.6001.18000 (longhorn_rtm.080118-1840)"
            VALUE "InternalName",     "Text3D"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "Text3D"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "6.0.6001.18000"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
