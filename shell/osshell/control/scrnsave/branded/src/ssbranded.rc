//-----------------------------------------------------------------------------
// File: ssbranded.rc
//
// Desc: Resources of the Windows Energy screen saver (ssBranded.scr).
//
//       In the shipped product the language-neutral resources (media, icon,
//       manifest, version) live in ssBranded.scr and the strings in
//       en-US\ssBranded.scr.mui; this script builds all of them into the .scr.
//
//       The effects (fx\), meshes and key frame animations (media\) are text
//       files and part of this source tree.  The pictures (Targa files) and
//       the icon are NOT: run tools\extract_assets.py against your own copy
//       of ssBranded.scr to create the res\ directory, or build with
//       SCRNSAVE_NO_ASSETS defined (the screen saver then reports that it
//       cannot find its textures).
//
//       Original object:
//           shell\osshell\control\scrnsave\branded\src\objfre\amd64\ssbranded.res
//-----------------------------------------------------------------------------
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

//-----------------------------------------------------------------------------
// Effects
//-----------------------------------------------------------------------------
IDR_FX_FSBANNER                 RCDATA  "fx/FSBanner.fx"
IDR_FX_LOGOGLOW                 RCDATA  "fx/LogoGlow.fx"
IDR_FX_WIPE                     RCDATA  "fx/Wipe.fx"
IDR_FX_AURORA                   RCDATA  "fx/Aurora.fx"
IDR_FX_FLARE                    RCDATA  "fx/Flare.fx"
IDR_FX_PILL                     RCDATA  "fx/Pill.fx"
IDR_FX_POSTPROC                 RCDATA  "fx/PostProc.fx"
IDR_FX_PP_COLORBLOOMH           RCDATA  "fx/PP_ColorBloomH.fx"
IDR_FX_PP_COLORGBLURV           RCDATA  "fx/PP_ColorGBlurV.fx"
IDR_FX_PP_COLORBRIGHTPASS       RCDATA  "fx/PP_ColorBrightPass.fx"
IDR_FX_PP_COLORDOWNFILTER4      RCDATA  "fx/PP_ColorDownFilter4.fx"
IDR_FX_PP_COLORUPFILTER         RCDATA  "fx/PP_ColorUpFilter.fx"
IDR_FX_PP_COLORCOMBINE4         RCDATA  "fx/PP_ColorCombine4.fx"

//-----------------------------------------------------------------------------
// Meshes (DirectX .x, text format)
//-----------------------------------------------------------------------------
IDR_X_QUAD                      RCDATA  "media/quad.x"
IDR_X_FLARE                     RCDATA  "media/flare.x"
IDR_X_PILL                      RCDATA  "media/pill.x"

//-----------------------------------------------------------------------------
// Key frame animations (see CAnimation::Load)
//-----------------------------------------------------------------------------
IDR_ANIM_LOGO                   RCDATA  "media/logo.anim"
IDR_ANIM_MSFLARE                RCDATA  "media/msflare.anim"
IDR_ANIM_PILL1                  RCDATA  "media/pill1.anim"
IDR_ANIM_PILL2_00               RCDATA  "media/pill2_00.anim"
IDR_ANIM_PILL2_01               RCDATA  "media/pill2_01.anim"
IDR_ANIM_PILL2_02               RCDATA  "media/pill2_02.anim"
IDR_ANIM_PILL2_03               RCDATA  "media/pill2_03.anim"
IDR_ANIM_PILL2_04               RCDATA  "media/pill2_04.anim"
IDR_ANIM_PILL2_05               RCDATA  "media/pill2_05.anim"
IDR_ANIM_PILL2_06               RCDATA  "media/pill2_06.anim"
IDR_ANIM_PILL2_07               RCDATA  "media/pill2_07.anim"
IDR_ANIM_PILL2_08               RCDATA  "media/pill2_08.anim"
IDR_ANIM_PILL2_09               RCDATA  "media/pill2_09.anim"
IDR_ANIM_XFORM                  RCDATA  "media/xform.anim"

//-----------------------------------------------------------------------------
// Pictures and icon (extracted from the original, see above)
//-----------------------------------------------------------------------------
#ifndef SCRNSAVE_NO_ASSETS

// The original names its icon group "IDI_MAIN_ICON" (a string: its script
// did not see the numeric IDI_MAIN_ICON of d3dsaver9res.h), so the window
// class of D3DSaver9, which asks for icon 101, gets no icon.
#undef IDI_MAIN_ICON
IDI_MAIN_ICON                   ICON    "res/ssbranded.ico"

