//-----------------------------------------------------------------------------
// Strings
//-----------------------------------------------------------------------------
STRINGTABLE
BEGIN
    IDS_DESCRIPTION                 "Windows Energy"
    IDS_CONFIG_TITLE                "Windows Energy Screen Saver"
    IDS_CONFIG_NOOPTIONS            "No options"
    IDS_CONFIG_NOOPTIONS_TEXT       "This screen saver has no options that you can set."
END

//-----------------------------------------------------------------------------
// Error strings of the D3DSaver9 framework (no display settings dialogs)
//-----------------------------------------------------------------------------
#define D3DSAVER9_NO_DIALOGS
#include "../../d3dsaver9/d3dsaver9.rc"

//-----------------------------------------------------------------------------
// Version
//-----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
FILEVERSION     6,0,6001,18000
PRODUCTVERSION  6,0,6001,18000
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Windows Energy Screen Saver"
            VALUE "FileVersion",      "6.0.6001.18000 (longhorn_rtm.080118-1840)"
            VALUE "InternalName",     "ssBranded"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "ssBranded"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "6.0.6001.18000"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
