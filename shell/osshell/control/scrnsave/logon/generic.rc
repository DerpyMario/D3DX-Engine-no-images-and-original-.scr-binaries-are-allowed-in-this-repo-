IDB_FLARE09             BITMAP  "res/flare09.bmp"
IDB_FLARE10             BITMAP  "res/flare10.bmp"
IDB_FLARE11             BITMAP  "res/flare11.bmp"
IDB_FLARE12             BITMAP  "res/flare12.bmp"
