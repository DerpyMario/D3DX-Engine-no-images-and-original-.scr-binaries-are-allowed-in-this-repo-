//-----------------------------------------------------------------------------
// File: generic.rc
//
// Desc: Resources of the Windows Logo screen saver (logon.scr).
//
//       In the shipped product the language-neutral resources (bitmaps,
//       manifest, version) live in logon.scr and the localisable ones
//       (dialog, strings) in en-US\logon.scr.mui; this script simply builds
//       all of them into the .scr.
//
//       The binary assets are NOT part of this source tree.  Run
//       tools\extract_assets.py against your own copy of logon.scr to create
//       the res\ directory, or build with SCRNSAVE_NO_ASSETS defined (the
//       saver then shows nothing but the logo).
//
//       Original object:
//           shell\osshell\control\scrnsave\logon\objfre\amd64\generic.res
//-----------------------------------------------------------------------------
#include <windows.h>
#include <scrnsave.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

//-----------------------------------------------------------------------------
// Binary assets (extracted from the original, see above).  The names are
// string names: logon.cpp builds them with "IDB_FLARE%02d".
//
//   IDB_FLARExx        the lens flare animation, 274 x 144 pixels, 24 bit
//   IDB_SMALLFLARExx   the same animation for the control panel preview, 69 x 36
//-----------------------------------------------------------------------------
#ifndef SCRNSAVE_NO_ASSETS
IDB_FLARE01             BITMAP  "res/flare01.bmp"
IDB_FLARE02             BITMAP  "res/flare02.bmp"
IDB_FLARE03             BITMAP  "res/flare03.bmp"
IDB_FLARE04             BITMAP  "res/flare04.bmp"
IDB_FLARE05             BITMAP  "res/flare05.bmp"
IDB_FLARE06             BITMAP  "res/flare06.bmp"
