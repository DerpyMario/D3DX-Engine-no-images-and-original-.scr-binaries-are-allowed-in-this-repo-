IDB_SMALLFLARE44        BITMAP  "res/smallflare44.bmp"
IDB_SMALLFLARE45        BITMAP  "res/smallflare45.bmp"
#endif

1                       RT_MANIFEST "logon.manifest"

//-----------------------------------------------------------------------------
// Configuration "dialog": an empty template, see ScreenSaverConfigureDialog()
//-----------------------------------------------------------------------------
DLG_SCRNSAVECONFIGURE DIALOGEX 0, 0, 0, 0
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Logo Screen Saver"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
END

//-----------------------------------------------------------------------------
// Strings
//-----------------------------------------------------------------------------
STRINGTABLE
BEGIN
    IDS_DESCRIPTION             "Windows Logo"
END

STRINGTABLE
BEGIN
    IDS_CONFIG_NOOPTIONS        "No options"
    IDS_CONFIG_NOOPTIONS_TEXT   "This screen saver has no options that you can set."
    IDS_CONFIG_TITLE            "Windows Logo Screen Saver"
END

//-----------------------------------------------------------------------------
// Version
//-----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
FILEVERSION     6,0,6001,18000
PRODUCTVERSION  6,0,6001,18000
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Logon Screen Saver"
            VALUE "FileVersion",      "6.0.6001.18000 (longhorn_rtm.080118-1840)"
            VALUE "InternalName",     "logon"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "logon"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "6.0.6001.18000"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
