//-----------------------------------------------------------------------------
// File: d3dsaver9.rc
//
// Desc: Resources that belong to the D3DSaver9 framework: the two "Display
//       Settings" dialogs and the error / information strings.  Every screen
//       saver that is built on D3DSaver9.lib pulls this file into its own
//       resource script:
//
//           #include "..\d3dsaver9\d3dsaver9.rc"
//
//       The templates and strings were recovered from the English (en-US)
//       .mui satellites.  They are the same in Aurora, Bubbles (Windows Vista
//       RTM) and 3D Text (Service Pack 1), except for the dialog font: define
//       D3DSAVER9_SP1 before including this file to get the newer one.
//       Windows Energy (ssBranded) ships the strings only: define
//       D3DSAVER9_NO_DIALOGS to leave the dialogs out.
//
//       Only CONTROL statements are used so that the compiled templates match
//       the originals bit for bit (control order, styles and the 0xFFFF id of
//       the static controls included).
//-----------------------------------------------------------------------------
#include <windows.h>
#include <commctrl.h>
#include "d3dsaver9res.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifdef D3DSAVER9_SP1
#define D3DSAVER9_DLGFONT   9, "Segoe UI", 0, 0, 0x0
#else
#define D3DSAVER9_DLGFONT   8, "MS Shell Dlg", 0, 0, 0x0
#endif

#ifndef D3DSAVER9_NO_DIALOGS

IDD_SINGLEMONITORSETTINGS DIALOGEX 0, 0, 255, 170
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT D3DSAVER9_DLGFONT
BEGIN
    CONTROL         "Video adapter", 65535, "Button", BS_GROUPBOX, 7, 7, 241, 69
    CONTROL         "Name:", 65535, "Static", SS_LEFT | WS_GROUP, 13, 18, 33, 8
    CONTROL         "", IDC_ADAPTERNAME, "Static", SS_LEFT | WS_GROUP, 57, 18, 159, 8
    CONTROL         "Rendering:", 65535, "Static", SS_LEFT | WS_GROUP, 13, 31, 36, 8
    CONTROL         "", IDC_RENDERING, "Static", SS_LEFT | WS_GROUP, 57, 31, 130, 17
    CONTROL         "&Help", IDC_MOREINFO, "Button", BS_PUSHBUTTON | WS_TABSTOP, 194, 33, 50, 14
    CONTROL         "&Disable hardware 3D rendering", IDC_DISABLEHW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 54, 215, 10
    CONTROL         "Display mode", IDC_DISPLAYMODEBOX, "Button", BS_GROUPBOX, 7, 84, 241, 55
    CONTROL         "Display &mode for this video adapter:", IDC_MODESSTATIC, "Static", SS_LEFT | WS_GROUP, 13, 95, 126, 8
    CONTROL         "", IDC_MODESCOMBO, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, 144, 93, 100, 133
    CONTROL         "Note: The Automatic display mode finds a mode that works well with your current screen saver settings and video adapter.", IDC_DISPLAYMODENOTE, "Static", SS_LEFT | WS_GROUP, 13, 109, 227, 27
    CONTROL         "Automatic", IDC_AUTOMATIC, "Static", SS_LEFT | NOT WS_VISIBLE | WS_GROUP, 184, 126, 32, 8
    CONTROL         "%d by %d, %d bit color", IDC_MODEFMT, "Static", SS_LEFT | NOT WS_VISIBLE | WS_GROUP, 13, 152, 71, 8
    CONTROL         "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 143, 148, 50, 14
    CONTROL         "Cancel", IDCANCEL, "Button", BS_PUSHBUTTON | WS_TABSTOP, 197, 148, 50, 14
END

IDD_MULTIMONITORSETTINGS DIALOGEX 0, 0, 270, 236
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT D3DSAVER9_DLGFONT
BEGIN
    CONTROL         "Monitor %d", IDC_TABNAMEFMT, "Static", SS_LEFT | NOT WS_VISIBLE | WS_GROUP, 214, 8, 32, 8
    CONTROL         "Video adapter", 65535, "Button", BS_GROUPBOX, 13, 23, 244, 65
    CONTROL         "Name:", 65535, "Static", SS_LEFT | WS_GROUP, 19, 35, 40, 8
    CONTROL         "", IDC_ADAPTERNAME, "Static", SS_LEFT | WS_GROUP, 65, 35, 168, 8
    CONTROL         "Rendering:", 65535, "Static", SS_LEFT | WS_GROUP, 19, 48, 40, 8
    CONTROL         "", IDC_RENDERING, "Static", SS_LEFT | WS_GROUP, 65, 48, 132, 17
    CONTROL         "&Help", IDC_MOREINFO, "Button", BS_PUSHBUTTON | WS_TABSTOP, 202, 49, 50, 14
    CONTROL         "&Disable hardware 3D rendering on this monitor", IDC_DISABLEHW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 19, 71, 215, 10
    CONTROL         "Monitor usage", IDC_SCREENUSAGEBOX, "Button", BS_GROUPBOX, 13, 94, 244, 44
    CONTROL         "Display &screen saver on this monitor", IDC_RENDER, "Button", BS_AUTORADIOBUTTON, 19, 107, 200, 10
    CONTROL         "Display &nothing on this monitor", IDC_LEAVEBLACK, "Button", BS_AUTORADIOBUTTON, 19, 120, 200, 10
    CONTROL         "Display mode", IDC_DISPLAYMODEBOX, "Button", BS_GROUPBOX, 13, 146, 244, 55
    CONTROL         "Display &mode for this video adapter:", IDC_MODESSTATIC, "Static", SS_LEFT | WS_GROUP, 19, 158, 126, 8
    CONTROL         "", IDC_MODESCOMBO, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP, 152, 156, 100, 133
    CONTROL         "Note: The Automatic display mode finds a mode that works well with your current screen saver settings and video adapter.", IDC_DISPLAYMODENOTE, "Static", SS_LEFT | WS_GROUP, 19, 173, 232, 22
    CONTROL         "Automatic", IDC_AUTOMATIC, "Static", SS_LEFT | NOT WS_VISIBLE | WS_GROUP, 193, 182, 32, 8
    CONTROL         "%d by %d, %d bit color", IDC_MODEFMT, "Static", SS_LEFT | NOT WS_VISIBLE | WS_GROUP, 22, 221, 71, 8
    CONTROL         "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 159, 216, 50, 14
    CONTROL         "Cancel", IDCANCEL, "Button", BS_PUSHBUTTON | WS_TABSTOP, 213, 216, 50, 14
    CONTROL         "Tab1", IDC_MONITORSTAB, "SysTabControl32", WS_TABSTOP, 7, 7, 256, 201
END

#endif // D3DSAVER9_NO_DIALOGS

STRINGTABLE
BEGIN
    IDS_ERR_GENERIC                 "There was an unspecified problem starting this screen saver.  Your hardware might not be capable of running this screen saver"
    IDS_ERR_NODIRECT3D              "Direct3D 9.0 is needed to run this screen saver, but can't be found.  Please install the latest version of DirectX and try running the screen saver again."
    IDS_ERR_NOWINDOWEDHAL           "Windows could not start this screen saver.  Try previewing it in full screen mode."
    IDS_ERR_CREATEDEVICEFAILED      "Windows could not start this screen saver."
    IDS_ERR_NOCOMPATIBLEDEVICES     "The screen saver can't run because it requires a newer video card or one that's compatible with Direct3D."
    IDS_ERR_NOHARDWAREDEVICE        "The screen saver can't run because it requires hardware-acceleration functionality that is not available on the video card."
    IDS_ERR_HALNOTCOMPATIBLE        "This screen saver can't run because it requires functionality that is not available on your hardware-accelerated video card."
    IDS_ERR_NOHALTHISMODE           "The screen saver can't run because it requires functionality that is not available on your video card with the current desktop display settings.  Try a lower screen resolution or change the color depth to one that's supported by your video card."
    IDS_ERR_MEDIANOTFOUND           "Windows could not find the required textures for this screen saver.  You might try using a different screen saver."
    IDS_ERR_RESIZEFAILED            "Windows could not change the desktop resolution to start the screen saver.  Choose a resolution for the screen saver settings that is the same as your desktop resolution."
    IDS_ERR_OUTOFMEMORY             "There is not enough system memory to start this screen saver.  You might try closing some programs and then starting the screen saver again."
    IDS_ERR_OUTOFVIDEOMEMORY        "There is not enough video card memory to start this screen saver.  You might try lowering the desktop resolution, closing programs that are using video memory, or getting a new video card with more memory."
    IDS_ERR_NOPREVIEW               "No preview available"
    IDS_INFO_GOODHAL                "This video adapter supports hardware 3D rendering.  This screen saver can be displayed on this monitor."
    IDS_INFO_BADHAL_GOODSW          "This video adapter supports hardware 3D rendering, but this screensaver requires functionality not available in hardware.  A software renderer will be used instead.  This screen saver can be displayed on this monitor."
    IDS_INFO_BADHAL_BADSW           "This video adapter supports hardware 3D rendering, but this screensaver requires functionality not available in hardware or software.  This screen saver cannot be displayed on this monitor."
    IDS_INFO_BADHAL_NOSW            "This video adapter supports hardware 3D rendering, but this screensaver requires functionality not available in hardware.  No software renderer is available.  This screen saver cannot be displayed on this monitor."
    IDS_INFO_NOHAL_GOODSW           "This video adapter does not support hardware 3D rendering.  A software renderer will be used instead.  This screen saver can be displayed on this monitor."
    IDS_INFO_NOHAL_BADSW            "This video adapter does not support hardware 3D rendering.  This screensaver requires functionality not available in the software renderer.  This screen saver cannot be displayed on this monitor."
    IDS_INFO_NOHAL_NOSW             "This video adapter does not support hardware 3D rendering.  No software renderer is available.  This screen saver cannot be displayed on this monitor."
    IDS_INFO_DISABLEDHAL_GOODSW     "The video adapter supports hardware 3D rendering, but it has been disabled.  A software renderer will be used instead.  This screen saver can be displayed on this monitor."
    IDS_INFO_DISABLEDHAL_BADSW      "This video adapter supports hardware 3D rendering, but it has been disabled.  This screensaver requires functionality not available in the software renderer.  This screen saver cannot be displayed on this monitor."
    IDS_INFO_DISABLEDHAL_NOSW       "This video adapter supports hardware 3D rendering, but it has been disabled.  No software renderer is available.  This screen saver cannot be displayed on this monitor."
    IDS_RENDERING_HAL               "The screen saver can use hardware 3D rendering on this monitor."
    IDS_RENDERING_SW                "The screen saver can use software 3D rendering on this monitor."
    IDS_RENDERING_NONE              "The screen saver cannot be displayed on this monitor."
END
