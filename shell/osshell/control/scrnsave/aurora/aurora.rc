//-----------------------------------------------------------------------------
// File: aurora.rc
//
// Desc: Resources of the Aurora screen saver.
//
//       In the shipped product the language-neutral resources (icon, texture,
//       manifest, version) live in Aurora.scr and the localisable ones
//       (dialogs, strings) in en-US\Aurora.scr.mui; this script simply
//       builds all of them into the .scr.
//
//       The binary assets are NOT part of this source tree.  Run
//       tools\extract_assets.py against your own copy of Aurora.scr to create
//       the res\ directory, or build with SCRNSAVE_NO_ASSETS defined.
//
//       Original object:
//           shell\osshell\control\scrnsave\aurora\objfre\amd64\aurora.res
//-----------------------------------------------------------------------------
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

//-----------------------------------------------------------------------------
// Binary assets (extracted from the original, see above)
//-----------------------------------------------------------------------------
#ifndef SCRNSAVE_NO_ASSETS
IDI_MAIN_ICON           ICON    "res/aurora.ico"
IDR_ARC_TEXTURE         BMP     "res/arc.tga"       // a Targa file, in spite of the resource type
#endif

1                       RT_MANIFEST "aurora.manifest"

//-----------------------------------------------------------------------------
// Settings dialog (unused, see auroraconfig.cpp)
//-----------------------------------------------------------------------------
IDD_AURORA_SETTINGS DIALOGEX 0, 0, 370, 193
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aurora Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    CONTROL         "OK", IDOK, CTL_BUTTON, BS_DEFPUSHBUTTON | WS_TABSTOP, 282, 108, 78, 18
    CONTROL         "Cancel", IDCANCEL, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 282, 132, 78, 18
    CONTROL         "&Display Settings...", IDC_SCREENSETTINGS, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 282, 156, 78, 18
    CONTROL         "Number of Layers", IDC_NUMLAYERS_BOX, CTL_BUTTON, BS_GROUPBOX, 6, 6, 174, 36
    CONTROL         "", IDC_NUMLAYERS, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 12, 18, 165, 18
    CONTROL         "Speed", IDC_SPEED_BOX, CTL_BUTTON, BS_GROUPBOX, 186, 6, 174, 36
    CONTROL         "", IDC_SPEED, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 192, 18, 162, 18
    CONTROL         "Screensaver by Stephen Coy", -1, CTL_STATIC, SS_RIGHT | WS_GROUP, 246, 180, 114, 12
    CONTROL         "Preset 1", IDC_PRESET1, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 6, 96, 78, 18
    CONTROL         "Preset 2", IDC_PRESET2, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 6, 120, 78, 18
    CONTROL         "Preset 3", IDC_PRESET3, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 6, 144, 78, 18
    CONTROL         "bold streaks of twisting light", -1, CTL_STATIC, SS_CENTER | SS_CENTERIMAGE | SS_SUNKEN | 0x20 | WS_GROUP, 84, 96, 96, 18
    CONTROL         "sparse, delicate curves", -1, CTL_STATIC, SS_CENTER | SS_CENTERIMAGE | SS_SUNKEN | 0x20 | WS_GROUP, 84, 120, 96, 18
    CONTROL         "tangled threads woven into cloth-like textures", -1, CTL_STATIC, SS_CENTER | SS_SUNKEN | 0x20 | WS_GROUP, 84, 144, 96, 18
    CONTROL         "Span Multiple Monitors", IDC_SPANMULTIMON, CTL_BUTTON, BS_AUTOCHECKBOX | WS_TABSTOP, 189, 97, 102, 12
    CONTROL         "Brightness", IDC_BRIGHTNESS_BOX, CTL_BUTTON, BS_GROUPBOX, 6, 48, 174, 36
    CONTROL         "", IDC_BRIGHTNESS, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 12, 60, 165, 18
    CONTROL         "Preset 4", IDC_PRESET4, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 6, 168, 78, 18
    CONTROL         "soft washes of color overlayed with stars", -1, CTL_STATIC, SS_CENTER | SS_SUNKEN | WS_GROUP, 84, 168, 96, 18
    CONTROL         "Amplitude", IDC_AMPLITUDE_BOX, CTL_BUTTON, BS_GROUPBOX, 186, 48, 174, 36
    CONTROL         "", IDC_AMPLITUDE, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 192, 60, 162, 18
END

STRINGTABLE
BEGIN
    IDS_DESCRIPTION                 "Aurora"
    IDS_CONFIG_TITLE                "Aurora Screen Saver"
    IDS_CONFIG_NOOPTIONS            "No options"
    IDS_CONFIG_NOOPTIONS_TEXT       "This screen saver has no options that you can set."
END

//-----------------------------------------------------------------------------
// Version
//-----------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
FILEVERSION     6,0,6000,16386
PRODUCTVERSION  6,0,6000,16386
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Aurora Screen Saver"
            VALUE "FileVersion",      "6.0.6000.16386 (vista_rtm.061101-2205)"
            VALUE "InternalName",     "Aurora"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "Aurora"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "6.0.6000.16386"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

//-----------------------------------------------------------------------------
// D3DSaver9 framework resources (display-settings dialogs, error strings)
//-----------------------------------------------------------------------------
#include "../d3dsaver9/d3dsaver9.rc"
