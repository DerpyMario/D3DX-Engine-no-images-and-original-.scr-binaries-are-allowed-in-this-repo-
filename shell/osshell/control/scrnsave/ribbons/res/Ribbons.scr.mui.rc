////////////////////////////////////////////////////////////////////////////////
// Ribbons.scr.mui - resource script (compiles into Ribbons.scr.mui)
//
// Resource-only PE32 (x86) satellite; no entry point, no exports.
// All resources are language 0x409 (en-US):
//   RT_MUI     ID 1     configuration record pointing back to the .scr
//   RT_DIALOG  ID 105   "Ribbons Settings"
//   RT_DIALOG  ID 200   "Display Settings" (single monitor)
//   RT_DIALOG  ID 201   "Display Settings" (multi-monitor, tabbed)
//   RT_STRING  blocks 1 / 19 / 132 / 133 / 138 / 139
//   RT_VERSION ID 1     10.0.19041.1
////////////////////////////////////////////////////////////////////////////////

#include "src/resources.h"
#include <winuser.h>   // windres: style constant definitions

////////////////////////////////////////////////////////////////////////////////
// DLGTEMPLATEEX 105: "Ribbons Settings" (20 controls)
105 DIALOGEX 84, 0, 370, 193
STYLE 0x80c800c8
EXSTYLE 0x0
CAPTION "Ribbons Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL "OK", 1, "BUTTON", 0x50010001, 282, 108, 78, 18
    CONTROL "Cancel", 2, "BUTTON", 0x50010000, 282, 132, 78, 18
    CONTROL "&Display Settings...", 1002, "BUTTON", 0x50010000, 282, 156, 78, 18
    CONTROL "Number of Ribbons", -1, "BUTTON", 0x50000007, 6, 6, 174, 36
    CONTROL "", 1030, "msctls_trackbar32", 0x50010018, 12, 18, 165, 18
    CONTROL "Ribbon Width", -1, "BUTTON", 0x50000007, 186, 6, 174, 36
    CONTROL "", 1036, "msctls_trackbar32", 0x50010018, 192, 18, 162, 18
    CONTROL "Screensaver by Stephen Coy", -1, "STATIC", 0x50020002, 246, 180, 114, 12
    CONTROL "Preset 1", 1033, "BUTTON", 0x50010000, 6, 96, 78, 18
    CONTROL "Preset 2", 1034, "BUTTON", 0x50010000, 6, 120, 78, 18
    CONTROL "Preset 3", 1035, "BUTTON", 0x50010000, 6, 144, 78, 18
    CONTROL "bold streaks of twisting light", -1, "STATIC", 0x50021221, 84, 96, 96, 18
    CONTROL "sparse, delicate curves", -1, "STATIC", 0x50021221, 84, 120, 96, 18
    CONTROL "tangled threads woven into cloth-like textures", -1, "STATIC", 0x50021021, 84, 144, 96, 18
    CONTROL "Span Multiple Monitors", 1020, "BUTTON", 0x50010003, 192, 54, 102, 12
    CONTROL "Apply Blur and Fade", 1021, "BUTTON", 0x50010003, 192, 73, 102, 12
    CONTROL "Camera Field of View Angle", -1, "BUTTON", 0x50000007, 6, 48, 174, 36
    CONTROL "", 1031, "msctls_trackbar32", 0x50010018, 12, 60, 165, 18
    CONTROL "Preset 4", 1037, "BUTTON", 0x50010000, 6, 168, 78, 18
    CONTROL "soft washes of color overlayed with stars", -1, "STATIC", 0x50021001, 84, 168, 96, 18
END
////////////////////////////////////////////////////////////////////////////////
// DLGTEMPLATEEX 200: "Display Settings" (9 controls)
200 DIALOGEX 197, 0, 255, 107
STYLE 0x80c800c0
EXSTYLE 0x0
CAPTION "Display Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL "Video adapter", 65535, "BUTTON", 0x50000007, 7, 7, 241, 69
    CONTROL "Name:", 65535, "STATIC", 0x50020000, 13, 18, 33, 8
    CONTROL "", 2002, "STATIC", 0x50020000, 57, 18, 159, 8
    CONTROL "Rendering:", 65535, "STATIC", 0x50020000, 13, 31, 36, 8
    CONTROL "", 2003, "STATIC", 0x50020000, 57, 31, 130, 17
    CONTROL "&Help", 2004, "BUTTON", 0x50010000, 194, 33, 50, 14
    CONTROL "&Disable hardware 3D rendering", 2005, "BUTTON", 0x50010003, 14, 54, 215, 10
    CONTROL "OK", 1, "BUTTON", 0x50010001, 143, 85, 50, 14
    CONTROL "Cancel", 2, "BUTTON", 0x50010000, 197, 85, 50, 14
END
////////////////////////////////////////////////////////////////////////////////
// DLGTEMPLATEEX 201: "Display Settings" (14 controls)
201 DIALOGEX 7, 0, 270, 173
STYLE 0x80c800c0
EXSTYLE 0x0
CAPTION "Display Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL "Monitor %d", 2001, "STATIC", 0x40020000, 214, 8, 32, 8
    CONTROL "Video adapter", 65535, "BUTTON", 0x50000007, 13, 23, 244, 65
    CONTROL "Name:", 65535, "STATIC", 0x50020000, 19, 35, 40, 8
    CONTROL "", 2002, "STATIC", 0x50020000, 65, 35, 168, 8
    CONTROL "Rendering:", 65535, "STATIC", 0x50020000, 19, 48, 40, 8
    CONTROL "", 2003, "STATIC", 0x50020000, 65, 48, 132, 17
    CONTROL "&Help", 2004, "BUTTON", 0x50010000, 202, 49, 50, 14
    CONTROL "&Disable hardware 3D rendering on this monitor", 2005, "BUTTON", 0x50010003, 19, 71, 215, 10
    CONTROL "Monitor usage", 2006, "BUTTON", 0x50000007, 13, 94, 244, 44
    CONTROL "Display &screen saver on this monitor", 2007, "BUTTON", 0x50000009, 19, 107, 200, 10
    CONTROL "Display &nothing on this monitor", 2008, "BUTTON", 0x50000009, 19, 120, 200, 10
    CONTROL "OK", 1, "BUTTON", 0x50010001, 159, 153, 50, 14
    CONTROL "Cancel", 2, "BUTTON", 0x50010000, 213, 153, 50, 14
    CONTROL "Tab1", 2000, "SysTabControl32", 0x50010000, 7, 7, 256, 138
END
////////////////////////////////////////////////////////////////////////////////
// RT_STRING blocks of the .mui satellite. The MUI loader maps LoadStringW(id)
// onto satellite block (id/16)+1, entry id%16 - the block numbers below are
// therefore +1 versus the language-neutral IDs documented in src/resources.h.

// block 1 (language-neutral IDs 1..1)
STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
    1      "Ribbons"
END

// block 19 (language-neutral IDs 300..302)
STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
    300    "Ribbons Screen Saver"
    301    "No options"
    302    "This screen saver has no options that you can set."
END

// block 132 (language-neutral IDs 2100..2111)
STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
    2100   "There was an unspecified problem starting this screen saver.  Your hardware might not be capable of running this screen saver"
    2101   "Direct3D 9.0 is needed to run this screen saver, but can't be found.  Please install the latest version of DirectX and try running the screen saver again."
    2102   "Windows could not start this screen saver.  Try previewing it in full screen mode."
    2103   "Windows could not start this screen saver."
    2104   "The screen saver can't run because it requires a newer video card or one that's compatible with Direct3D."
    2105   "The screen saver can't run because it requires hardware-acceleration functionality that is not available on the video card."
    2106   "This screen saver can't run because it requires functionality that is not available on your hardware-accelerated video card."
    2107   "The screen saver can't run because it requires functionality that is not available on your video card with the current desktop display settings.  Try a lower screen resolution or change the color depth to one that's supported by your video card."
    2108   "Windows could not find the required textures for this screen saver.  You might try using a different screen saver."
    2109   "Windows could not change the desktop resolution to start the screen saver.  Choose a resolution for the screen saver settings that is the same as your desktop resolution."
    2110   "There is not enough system memory to start this screen saver.  You might try closing some programs and then starting the screen saver again."
    2111   "There is not enough video card memory to start this screen saver.  You might try lowering the desktop resolution, closing programs that are using video memory, or getting a new video card with more memory."
END

// block 133 (language-neutral IDs 2112..2112)
STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
    2112   "No preview available"
END

// block 138 (language-neutral IDs 2200..2207)
STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
    2200   "This video adapter supports hardware 3D rendering.  This screen saver can be displayed on this monitor."
    2201   "This video adapter supports hardware 3D rendering, but this screensaver requires functionality not available in hardware.  A software renderer will be used instead.  This screen saver can be displayed on this monitor."
    2202   "This video adapter supports hardware 3D rendering, but this screensaver requires functionality not available in hardware or software.  This screen saver cannot be displayed on this monitor."
    2203   "This video adapter supports hardware 3D rendering, but this screensaver requires functionality not available in hardware.  No software renderer is available.  This screen saver cannot be displayed on this monitor."
    2204   "This video adapter does not support hardware 3D rendering.  A software renderer will be used instead.  This screen saver can be displayed on this monitor."
    2205   "This video adapter does not support hardware 3D rendering.  This screensaver requires functionality not available in the software renderer.  This screen saver cannot be displayed on this monitor."
    2206   "This video adapter does not support hardware 3D rendering.  No software renderer is available.  This screen saver cannot be displayed on this monitor."
    2207   "The video adapter supports hardware 3D rendering, but it has been disabled.  A software renderer will be used instead.  This screen saver can be displayed on this monitor."
END

// block 139 (language-neutral IDs 2208..2212)
STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
BEGIN
    2208   "This video adapter supports hardware 3D rendering, but it has been disabled.  This screensaver requires functionality not available in the software renderer.  This screen saver cannot be displayed on this monitor."
    2209   "This video adapter supports hardware 3D rendering, but it has been disabled.  No software renderer is available.  This screen saver cannot be displayed on this monitor."
    2210   "The screen saver can use hardware 3D rendering on this monitor."
    2211   "The screen saver can use software 3D rendering on this monitor."
    2212   "The screen saver cannot be displayed on this monitor."
END

1 MUI "resources/mui_files/MUI/1_lang1033.bin"

1 VERSIONINFO
 FILEVERSION 10,0,19041,1
 PRODUCTVERSION 10,0,19041,1
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Ribbons Screen Saver Resource DLL"
            VALUE "FileVersion", "10.0.19041.1"
        END
    END
END
