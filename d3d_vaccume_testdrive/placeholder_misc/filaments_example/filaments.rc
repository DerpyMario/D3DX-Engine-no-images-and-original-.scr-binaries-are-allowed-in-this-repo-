//-----------------------------------------------------------------------------
// This resource is an example placeholder
//-----------------------------------------------------------------------------
include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_DESCRIPTION     "Filaments"
END

IDD_CONFIG DIALOGEX 0, 0, 244, 214
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Filaments Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Shape", IDC_MODE_LABEL, 12, 8, 60, 8
    AUTORADIOBUTTON "Thin &lines", IDC_MODE_LINES, 72, 7, 70, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Wide &ribbons", IDC_MODE_RIBBONS, 150, 7, 80, 10

    LTEXT           "Number of strands", IDC_COUNT_LABEL, 12, 26, 120, 8
    CONTROL         "", IDC_COUNT, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 36, 216, 18

    LTEXT           "Strand width", IDC_WIDTH_LABEL, 12, 60, 120, 8
    CONTROL         "", IDC_WIDTH, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 70, 216, 18

    LTEXT           "Camera field of view", IDC_FOV_LABEL, 12, 94, 120, 8
    CONTROL         "", IDC_FOV, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 104, 216, 18

    LTEXT           "Trail length", IDC_FADE_LABEL, 12, 128, 120, 8
    CONTROL         "", IDC_FADE, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 12, 138, 216, 18

    AUTOCHECKBOX    "Span all &monitors", IDC_SPAN, 12, 166, 110, 10
    AUTOCHECKBOX    "Cycle &colours across strands", IDC_RAINBOW, 128, 166, 110, 10

    DEFPUSHBUTTON   "OK", IDOK, 132, 192, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 186, 192, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Filaments Screen Saver"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Filaments"
            VALUE "OriginalFilename", "Filaments.scr"
            VALUE "ProductName",      "D3DX-Engine original screen savers"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4B0
    END
END
