/*-----------------------------------------------------------------------------
 * File: mystify.rc
 *
 * Desc: Resources of the Mystify screen saver (ssmyst.scr) of Windows Server
 *       2003 / Windows XP x64.
 *
 *       The icon is NOT part of this source tree: run tools/extract_assets.py
 *       against your own copy of ssmyst.scr, or build with SCRNSAVE_NO_ASSETS
 *       defined.
 *---------------------------------------------------------------------------*/
#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "../common/comstr.h"
#include "mystify.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifndef SCRNSAVE_NO_ASSETS
ID_APP                  ICON    "res/mystify.ico"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "../common/screensavers.manifest"

DLG_SCRNSAVECONFIGURE DIALOG 8, 16, 236, 88
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_CONTEXTHELP
CAPTION "Mystify Setup"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 178, 8, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 178, 26, 50, 14, WS_GROUP
    GROUPBOX        "Object", -1, 4, 3, 168, 79
    LTEXT           "Sh&ape:", ID_SHAPE_LABEL, 8, 20, 30, 12
    COMBOBOX        ID_SHAPE, 42, 19, 48, 30, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CHECKBOX        "Acti&ve", ID_ACTIVE, 94, 19, 32, 14, WS_GROUP | WS_TABSTOP
    LTEXT           "&Lines:", ID_LINES_LABEL, 140, 9, 30, 10
    EDITTEXT        ID_LINES, 140, 19, 25, 12, ES_AUTOHSCROLL | WS_GROUP
    CONTROL         "", ID_LINESARROW, UPDOWN_CLASS,
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | WS_GROUP | WS_TABSTOP,
                    152, 19, 7, 12
    GROUPBOX        "Colors To Use", ID_COLORGROUP, 8, 34, 158, 42
    RADIOBUTTON     "&Two Colors", ID_2COLORS, 12, 44, 60, 12, WS_GROUP | WS_TABSTOP
    COMBOBOX        ID_COLOR1, 76, 44, 40, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        ID_COLOR2, 120, 44, 40, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    RADIOBUTTON     "&Multiple Random Colors", ID_RANDOMCOLORS, 12, 61, 100, 12, WS_GROUP | WS_TABSTOP
    CHECKBOX        "&Clear Screen", ID_CLEARSCREEN, 178, 62, 60, 14, WS_GROUP | WS_TABSTOP
END

STRINGTABLE
BEGIN
    IDS_DESCRIPTION     "Mystify"
    idsPolygon          "Polygon %d"
END

STRINGTABLE
BEGIN
    idsName             "Mystify"
END

#define SAVER_APPNAME   "Screen Saver.Mystify"
#include "../common/comstr.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     5,2,3790,1830
PRODUCTVERSION  5,2,3790,1830
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Mystify Screen Saver"
            VALUE "FileVersion",      "5.2.3790.1830 (srv03_sp1_rtm.050324-1447)"
            VALUE "InternalName",     "ssmyst"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "ssmyst"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "5.2.3790.1830"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
