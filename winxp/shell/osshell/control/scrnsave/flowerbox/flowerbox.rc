//-----------------------------------------------------------------------------
// File: flowerbox.rc
//
// Desc: Resources of the 3D FlowerBox screen saver (ssflwbox.scr) of
//       Windows XP / Windows Server 2003 (x86).
//
//       The icon is NOT part of this source tree: run
//       tools/extract_assets.py against your own copy of the screen saver, or
//       build with SCRNSAVE_NO_ASSETS defined.
//-----------------------------------------------------------------------------
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifndef SCRNSAVE_NO_ASSETS
IDI_MAIN_ICON           ICON    "res/flowerbox.ico"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "flowerbox.manifest"

#include "../d3dsaver/d3dsaver.rc"

DLG_SCRNSAVECONFIGURE DIALOG 6, 18, 195, 196
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "3D FlowerBox Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Coloring", 65535, CTL_BUTTON, BS_GROUPBOX, 5, 5, 70, 95
    CONTROL         "&Checkerboard", ID_COL_CHECKER, CTL_BUTTON, BS_AUTORADIOBUTTON | WS_GROUP, 10, 17, 60, 10
    CONTROL         "&Per Side", ID_COL_PER_SIDE, CTL_BUTTON, BS_AUTORADIOBUTTON, 10, 29, 60, 10
    CONTROL         "&One Color", ID_COL_SINGLE, CTL_BUTTON, BS_AUTORADIOBUTTON, 10, 41, 60, 10
    CONTROL         "S&mooth", ID_COL_SMOOTH, CTL_BUTTON, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 10, 60, 40, 10
    CONTROL         "S&lanted", ID_COL_TRIANGLE, CTL_BUTTON, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 10, 72, 40, 10
    CONTROL         "C&ycle", ID_COL_CYCLE, CTL_BUTTON, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 10, 84, 40, 10
    CONTROL         "Comple&xity", 65535, CTL_BUTTON, BS_GROUPBOX, 5, 105, 185, 40
    CONTROL         "Slider1", DLG_SETUP_SUBDIV, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 10, 125, 175, 15
    CONTROL         "Min", 65535, CTL_STATIC, SS_LEFT | WS_GROUP, 10, 115, 30, 10
    CONTROL         "Max", 65535, CTL_STATIC, SS_RIGHT | WS_GROUP, 115, 115, 70, 10
    CONTROL         "Si&ze", 65535, CTL_BUTTON, BS_GROUPBOX, 5, 150, 185, 40
    CONTROL         "Slider2", DLG_SETUP_SIZE, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 10, 170, 175, 15
    CONTROL         "Smaller", 65535, CTL_STATIC, SS_LEFT | WS_GROUP, 10, 160, 40, 10
    CONTROL         "Larger", 65535, CTL_STATIC, SS_RIGHT | WS_GROUP, 115, 160, 70, 10
    CONTROL         "S&hape", 65535, CTL_BUTTON, BS_GROUPBOX, 79, 69, 111, 31
    CONTROL         "", ID_GEOM, CTL_COMBOBOX, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP, 85, 82, 100, 95
    CONTROL         "&Spin", ID_SPIN, CTL_BUTTON, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 90, 10, 50, 10
    CONTROL         "&Bloom", ID_BLOOM, CTL_BUTTON, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 90, 22, 50, 10
    CONTROL         "&Two-sided", ID_TWO_SIDED, CTL_BUTTON, BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 90, 34, 50, 10
    CONTROL         "OK", IDOK, CTL_BUTTON, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP, 150, 10, 40, 14
    CONTROL         "Cancel", IDCANCEL, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 150, 27, 40, 14
    CONTROL         "&Display Settings...", IDC_SCREENSETTINGS, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 90, 50, 91, 14
END

STRINGTABLE
BEGIN
    IDS_DESCRIPTION             "3D FlowerBox"
END

STRINGTABLE
BEGIN
    IDS_GEOM_CUBE               "Cube"
    IDS_GEOM_TETRA              "Tetrahedron"
    IDS_GEOM_PYRAMIDS           "Pyramids"
    IDS_GEOM_CYLINDER           "Cylinder"
    IDS_GEOM_SPRING             "Spring"
END

STRINGTABLE
BEGIN
    IDS_INIFILE                 "control.ini"
    IDS_SAVERNAME               "Screen Saver.3DFlowerBox"
    IDS_CONFIG_TRIANGLE_COLORS  "Slanted"
    IDS_CONFIG_CYCLE_COLORS     "Cycle"
    IDS_CONFIG_SPIN             "Spin"
    IDS_CONFIG_BLOOM            "Bloom"
    IDS_CONFIG_SUBDIV           "Subdiv"
    IDS_CONFIG_COLOR_PICK       "ColorPick"
    IDS_CONFIG_IMAGE_SIZE       "ImageSize"
    IDS_CONFIG_GEOM             "Geom"
    IDS_CONFIG_TWO_SIDED        "TwoSided"
    IDS_CONFIG_SMOOTH_COLORS    "Smooth"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     5,2,3790,3959
PRODUCTVERSION  5,2,3790,3959
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Direct3D Flowerbox Screen Saver"
            VALUE "FileVersion",      "5.2.3790.3959 (srv03_sp2_rtm.070216-1710)"
            VALUE "InternalName",     "FlowerBox"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "FlowerBox"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "5.2.3790.3959"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
