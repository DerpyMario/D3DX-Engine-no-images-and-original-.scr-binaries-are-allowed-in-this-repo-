//-----------------------------------------------------------------------------
// File: blank.rc
//
// Desc: Resources of the Blank screen saver (scrnsave.scr) of Windows XP
//       Professional x64 Edition / Windows Server 2003 SP1.
//
//       The icon is NOT part of this source tree: run tools/extract_assets.py
//       against your own copy of scrnsave.scr to create the res/ directory,
//       or build with SCRNSAVE_NO_ASSETS defined.
//-----------------------------------------------------------------------------
#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifndef SCRNSAVE_NO_ASSETS
// The icon group has a string name, "IW" (from the screen saver server
// IWLIB.DLL the program can drive).
IW                      ICON    "res/blank.ico"
#endif

STRINGTABLE
BEGIN
    1                   "Blank"
    100                 "Blank Screen Saver"
    101                 "This screen saver has no options that you can set."
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     5,2,3790,1830
PRODUCTVERSION  5,2,3790,1830
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Default Screen Saver"
            VALUE "FileVersion",      "5.2.3790.1830 (srv03_sp1_rtm.050324-1447)"
            VALUE "InternalName",     "scrnsave"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "scrnsave"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "5.2.3790.1830"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
