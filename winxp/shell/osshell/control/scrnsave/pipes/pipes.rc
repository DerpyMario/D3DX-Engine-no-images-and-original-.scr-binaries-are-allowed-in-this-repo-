//-----------------------------------------------------------------------------
// File: pipes.rc
//
// Desc: Resources of the 3D Pipes screen saver (sspipes.scr) of Windows XP /
//       Windows Server 2003 (x86).
//
//       The icon and the default texture are NOT part of this source tree.
//       Run tools/extract_assets.py against your own copy of the screen saver
//       to create the res/ directory, or build with SCRNSAVE_NO_ASSETS
//       defined (the textured surface style then needs a texture file).
//-----------------------------------------------------------------------------
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifndef SCRNSAVE_NO_ASSETS
IDI_MAIN_ICON           ICON    "res/pipes.ico"
IDB_DEFTEX              BITMAP  "res/deftex.bmp"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "pipes.manifest"

#include "../d3dsaver/d3dsaver.rc"

//-----------------------------------------------------------------------------
// Settings dialog
//-----------------------------------------------------------------------------
IDD_CONFIGURE DIALOG 28, 25, 318, 140
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "3D Pipes Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "OK", IDOK, CTL_BUTTON, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP, 207, 120, 50, 14
    CONTROL         "Cancel", IDCANCEL, CTL_BUTTON, BS_PUSHBUTTON | WS_GROUP | WS_TABSTOP, 262, 120, 50, 14
    CONTROL         "Pipes", -1, CTL_BUTTON, BS_GROUPBOX, 6, 7, 150, 50
    CONTROL         "&Single", IDC_RADIO_SINGLE_PIPE, CTL_BUTTON, BS_AUTORADIOBUTTON, 16, 22, 35, 10
    CONTROL         "&Multiple", IDC_RADIO_MULTIPLE_PIPES, CTL_BUTTON, BS_AUTORADIOBUTTON, 16, 37, 40, 10
    CONTROL         "Pipe Style", -1, CTL_BUTTON, BS_GROUPBOX, 162, 7, 150, 50
    CONTROL         "&Joint Type:", IDC_STATIC_JOINT_TYPE, CTL_STATIC, SS_LEFT | WS_GROUP, 178, 22, 35, 8
    CONTROL         "", IDC_COMBO_JOINT_TYPE, CTL_COMBOBOX, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP, 178, 32, 115, 50
    CONTROL         "Surface Style", -1, CTL_BUTTON, BS_GROUPBOX | WS_GROUP, 6, 60, 150, 50
    CONTROL         "S&olid", IDC_RADIO_SOLID, CTL_BUTTON, BS_AUTORADIOBUTTON | WS_TABSTOP, 16, 73, 35, 13
    CONTROL         "Te&xtured", IDC_RADIO_TEX, CTL_BUTTON, BS_AUTORADIOBUTTON | WS_TABSTOP, 16, 88, 48, 14
    CONTROL         "&Choose Texture...", IDC_BUTTON_TEXTURE, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 70, 88, 66, 14
    CONTROL         "&Display Settings...", IDC_SCREENSETTINGS, CTL_BUTTON, BS_PUSHBUTTON | WS_TABSTOP, 6, 120, 94, 14
    CONTROL         "Speed", -1, CTL_BUTTON, BS_GROUPBOX, 162, 60, 150, 50
    CONTROL         "Slider1", IDC_SPEED_SLIDER, "msctls_trackbar32", TBS_BOTH | TBS_NOTICKS | WS_TABSTOP, 173, 83, 127, 15
    CONTROL         "Slow", -1, CTL_STATIC, SS_LEFT | WS_GROUP, 178, 72, 16, 8
    CONTROL         "Fast", -1, CTL_STATIC, SS_LEFT | WS_GROUP, 281, 72, 14, 8
END

STRINGTABLE
BEGIN
    IDS_DESCRIPTION             "3D Pipes"
END

STRINGTABLE
BEGIN
    // '#' separates the strings of the filter (replaced by '\0' at run time)
    IDS_TEXTUREFILTER           "Texture Files (*.bmp;*.jpg;*.tga;*.png)#*.bmp;*.jpg;*.tga;*.png#"
    IDS_TEXTUREDIALOGTITLE      "Choose Texture File"
    IDS_SAVERNAME               "3D Pipes"
END

STRINGTABLE
BEGIN
    IDS_JOINT_ELBOW             "Elbow"
    IDS_JOINT_BALL              "Ball"
    IDS_JOINT_MIXED             "Mixed"
    IDS_JOINT_CYCLE             "Cycle"
END

STRINGTABLE
BEGIN
    IDS_JOINT_TYPE              "JointType"
    IDS_SURFSTYLE               "SurfStyle"
    IDS_TEXQUAL                 "TextureQuality"
    IDS_MULTIPIPES              "MultiPipes"
    IDS_SECTION                 "Screen Saver.3DPipes"
    IDS_INIFILE                 "control.ini"
    IDS_TEXTURE                 "Texture"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     5,2,3790,3959
PRODUCTVERSION  5,2,3790,3959
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Direct3D Pipes Screen Saver"
            VALUE "FileVersion",      "5.2.3790.3959 (srv03_sp2_rtm.070216-1710)"
            VALUE "InternalName",     "Pipes"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "Pipes"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "5.2.3790.3959"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
