/*-----------------------------------------------------------------------------
 * File: bezier.rc
 *
 * Desc: Resources of the Beziers screen saver (ssbezier.scr) of Windows
 *       Server 2003 / Windows XP x64.
 *
 *       The icon is NOT part of this source tree: run tools/extract_assets.py
 *       against your own copy of ssbezier.scr, or build with
 *       SCRNSAVE_NO_ASSETS defined.
 *---------------------------------------------------------------------------*/
#include <windows.h>
#include <commctrl.h>
#include <scrnsave.h>
#include "../common/comstr.h"
#include "bezier.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#ifndef SCRNSAVE_NO_ASSETS
ID_APP                  ICON    "res/bezier.ico"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "../common/windowsscreensaver.manifest"

DLG_SCRNSAVECONFIGURE DIALOG 8, 16, 208, 105
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_CONTEXTHELP
CAPTION "Bezier Screen Saver Setup"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK", IDOK, 162, 8, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 26, 40, 14
    GROUPBOX        "&Length", -1, 6, 4, 150, 26
    LTEXT           "Beziers in each loop (1-10)", ID_LENGTH_LABEL, 10, 18, 90, 8
    EDITTEXT        ID_LENGTH, 123, 15, 26, 12
    CONTROL         "", ID_LENGTHARROW, UPDOWN_CLASS,
                    UDS_WRAP | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,
                    141, 15, 8, 12
    GROUPBOX        "&Width", -1, 6, 34, 150, 26
    LTEXT           "Repeat each loop (1-100)", -1, 10, 48, 92, 8
    EDITTEXT        ID_WIDTH, 118, 45, 31, 12
    CONTROL         "", ID_WIDTHARROW, UPDOWN_CLASS,
                    UDS_WRAP | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,
                    141, 45, 8, 12
    GROUPBOX        "&Speed", -1, 6, 64, 150, 36
    LTEXT           "Slow", ID_SLOW, 10, 76, 32, 8
    RTEXT           "Fast", ID_FAST, 116, 76, 32, 8
    SCROLLBAR       ID_SPEED, 10, 84, 138, 12, WS_GROUP | WS_TABSTOP
END

STRINGTABLE
BEGIN
    IDS_DESCRIPTION     "Beziers"
END

STRINGTABLE
BEGIN
    idsName             "Bezier"
END

#define SAVER_APPNAME   "Screen Saver.Bezier"
#include "../common/comstr.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     5,2,3790,1830
PRODUCTVERSION  5,2,3790,1830
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Microsoft Corporation"
            VALUE "FileDescription",  "Bezier Curves Screen Saver"
            VALUE "FileVersion",      "5.2.3790.1830 (srv03_sp1_rtm.050324-1447)"
            VALUE "InternalName",     "ssbezier"
            VALUE "LegalCopyright",   L"\x00a9 Microsoft Corporation. All rights reserved."
            VALUE "OriginalFilename", "ssbezier"
            VALUE "ProductName",      L"Microsoft\x00ae Windows\x00ae Operating System"
            VALUE "ProductVersion",   "5.2.3790.1830"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
